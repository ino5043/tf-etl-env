// =============================================================================
// dax-measures.dax — 製造業 IoT デモ セマンティックモデルのメジャー一括定義
// =============================================================================
// 生成元: dax-measures.md（このファイルは同ファイルのコードブロックから生成している）
// 使い方: DAX クエリ ビューに貼り付けて実行 →「モデルを更新する」で全メジャーを追加する。
//         書式文字列・表示フォルダーは dax-measures.md の表に従って追加後に設定する。
// 前提:   semantic-model.md のテーブル名・列名、dim_date が日付テーブルとしてマーク済み。
// 任意:   production_facts（明細ファクト）のメジャーは含めていない（dax-measures.md 6 章）。
// =============================================================================

DEFINE
    MEASURE daily_production_kpi[最終日] =
        CALCULATE (
            MAX ( daily_production_kpi[production_date] ),
            REMOVEFILTERS ( dim_line )
        )

    MEASURE daily_production_kpi[最終集計日時] =
        CALCULATE (
            MAX ( daily_production_kpi[_aggregated_at] ),
            REMOVEFILTERS ( dim_date ),
            REMOVEFILTERS ( dim_line )
        )

    MEASURE daily_production_kpi[最終集計日時 (JST)] =
        VAR _utc = [最終集計日時]
        RETURN
            IF ( NOT ISBLANK ( _utc ), _utc + TIME ( 9, 0, 0 ) )

    MEASURE daily_production_kpi[計画数] = SUM ( daily_production_kpi[total_planned_quantity] )

    MEASURE daily_production_kpi[実績数] = SUM ( daily_production_kpi[total_actual_quantity] )

    MEASURE daily_production_kpi[良品数] = SUM ( daily_production_kpi[total_good_quantity] )

    MEASURE daily_production_kpi[日勤実績数] = SUM ( daily_production_kpi[day_shift_quantity] )

    MEASURE daily_production_kpi[夜勤実績数] = SUM ( daily_production_kpi[night_shift_quantity] )

    MEASURE daily_production_kpi[計画差異] =
        VAR _plan = [計画数]
        VAR _actual = [実績数]
        RETURN
            IF ( NOT ISBLANK ( _plan ), _actual - _plan )

    MEASURE daily_production_kpi[達成率] = DIVIDE ( [実績数], [計画数] )

    MEASURE daily_production_kpi[夜勤比率] = DIVIDE ( [夜勤実績数], [実績数] )

    MEASURE daily_production_kpi[実績数 前日] = CALCULATE ( [実績数], DATEADD ( dim_date[calendar_date], -1, DAY ) )

    MEASURE daily_production_kpi[実績数 前日比] =
        VAR _cur = [実績数]
        VAR _prev = [実績数 前日]
        RETURN
            IF (
                NOT ISBLANK ( _cur ) && NOT ISBLANK ( _prev ),
                DIVIDE ( _cur - _prev, _prev )
            )

    MEASURE daily_production_kpi[実績数 前週同日] = CALCULATE ( [実績数], DATEADD ( dim_date[calendar_date], -7, DAY ) )

    MEASURE daily_production_kpi[実績数 前週比] =
        VAR _cur = [実績数]
        VAR _prev = [実績数 前週同日]
        RETURN
            IF (
                NOT ISBLANK ( _cur ) && NOT ISBLANK ( _prev ),
                DIVIDE ( _cur - _prev, _prev )
            )

    MEASURE daily_production_kpi[達成率 前日差] =
        VAR _cur = [達成率]
        VAR _prev =
            CALCULATE ( [達成率], DATEADD ( dim_date[calendar_date], -1, DAY ) )
        RETURN
            IF (
                NOT ISBLANK ( _cur ) && NOT ISBLANK ( _prev ),
                ( _cur - _prev ) * 100
            )

    MEASURE daily_production_kpi[実績数 7日移動平均] =
        VAR _end = MAX ( dim_date[calendar_date] )
        VAR _result =
            CALCULATE (
                AVERAGEX ( VALUES ( dim_date[calendar_date] ), [実績数] ),
                DATESINPERIOD ( dim_date[calendar_date], _end, -7, DAY )
            )
        RETURN
            IF ( NOT ISBLANK ( [実績数] ), _result )

    MEASURE daily_production_kpi[達成率 7日移動] =
        VAR _end = MAX ( dim_date[calendar_date] )
        VAR _result =
            CALCULATE (
                [達成率],
                DATESINPERIOD ( dim_date[calendar_date], _end, -7, DAY )
            )
        RETURN
            IF ( NOT ISBLANK ( [実績数] ), _result )

    MEASURE daily_production_kpi[計画数 (最終日)] =
        VAR _d = [最終日]
        RETURN
            CALCULATE ( [計画数], dim_date[calendar_date] = _d )

    MEASURE daily_production_kpi[実績数 (最終日)] =
        VAR _d = [最終日]
        RETURN
            CALCULATE ( [実績数], dim_date[calendar_date] = _d )

    MEASURE daily_production_kpi[計画差異 (最終日)] =
        VAR _d = [最終日]
        RETURN
            CALCULATE ( [計画差異], dim_date[calendar_date] = _d )

    MEASURE daily_production_kpi[達成率 (最終日)] =
        VAR _d = [最終日]
        RETURN
            CALCULATE ( [達成率], dim_date[calendar_date] = _d )

    MEASURE daily_production_kpi[実績数 前日比 (最終日)] =
        VAR _d = [最終日]
        RETURN
            CALCULATE ( [実績数 前日比], dim_date[calendar_date] = _d )

    MEASURE daily_production_kpi[達成率 前日差 (最終日)] =
        VAR _d = [最終日]
        RETURN
            CALCULATE ( [達成率 前日差], dim_date[calendar_date] = _d )

    MEASURE daily_production_kpi[実績数 7日移動平均 (最終日)] =
        VAR _d = [最終日]
        RETURN
            CALCULATE ( [実績数 7日移動平均], dim_date[calendar_date] = _d )

    MEASURE daily_production_kpi[不良数] = SUM ( daily_production_kpi[total_defect_quantity] )

    MEASURE daily_production_kpi[不良率] = DIVIDE ( [不良数], [実績数] )

    MEASURE daily_production_kpi[歩留まり率] = DIVIDE ( [良品数], [実績数] )

    MEASURE daily_production_kpi[不良率 前日差] =
        VAR _cur = [不良率]
        VAR _prev =
            CALCULATE ( [不良率], DATEADD ( dim_date[calendar_date], -1, DAY ) )
        RETURN
            IF (
                NOT ISBLANK ( _cur ) && NOT ISBLANK ( _prev ),
                ( _cur - _prev ) * 100
            )

    MEASURE daily_production_kpi[不良率 7日移動] =
        VAR _end = MAX ( dim_date[calendar_date] )
        VAR _result =
            CALCULATE (
                [不良率],
                DATESINPERIOD ( dim_date[calendar_date], _end, -7, DAY )
            )
        RETURN
            IF ( NOT ISBLANK ( [実績数] ), _result )

    MEASURE daily_production_kpi[不良率 目標差] =
        VAR _v = [不良率]
        RETURN
            IF ( NOT ISBLANK ( _v ), ( _v - [不良率 目標] ) * 100 )

    MEASURE daily_production_kpi[不良率 目標超過ライン数] =
        COALESCE (
            COUNTROWS (
                FILTER ( VALUES ( dim_line[line_id] ), [不良率] > [不良率 目標] )
            ),
            0
        )

    MEASURE daily_production_kpi[不良数 (最終日)] =
        VAR _d = [最終日]
        RETURN
            CALCULATE ( [不良数], dim_date[calendar_date] = _d )

    MEASURE daily_production_kpi[不良率 (最終日)] =
        VAR _d = [最終日]
        RETURN
            CALCULATE ( [不良率], dim_date[calendar_date] = _d )

    MEASURE daily_production_kpi[歩留まり率 (最終日)] =
        VAR _d = [最終日]
        RETURN
            CALCULATE ( [歩留まり率], dim_date[calendar_date] = _d )

    MEASURE daily_production_kpi[不良率 前日差 (最終日)] =
        VAR _d = [最終日]
        RETURN
            CALCULATE ( [不良率 前日差], dim_date[calendar_date] = _d )

    MEASURE daily_production_kpi[不良率 目標差 (最終日)] =
        VAR _d = [最終日]
        RETURN
            CALCULATE ( [不良率 目標差], dim_date[calendar_date] = _d )

    MEASURE daily_production_kpi[不良率 目標超過ライン数 (最終日)] =
        VAR _d = [最終日]
        RETURN
            CALCULATE ( [不良率 目標超過ライン数], dim_date[calendar_date] = _d )

    MEASURE equipment_health[計測数] = SUM ( equipment_health[measurement_count] )

    MEASURE equipment_health[異常発生回数] = SUM ( equipment_health[abnormal_count] )

    MEASURE equipment_health[正常稼働率 (簡易)] =
        VAR _total = [計測数]
        RETURN
            DIVIDE ( _total - [異常発生回数], _total )

    MEASURE equipment_health[監視設備数] = DISTINCTCOUNT ( equipment_health[equipment_id] )

    MEASURE equipment_health[温度アラート設備数] =
        CALCULATE (
            DISTINCTCOUNT ( equipment_health[equipment_id] ),
            KEEPFILTERS ( equipment_health[temperature_alert] = TRUE () )
        )

    MEASURE equipment_health[振動アラート設備数] =
        CALCULATE (
            DISTINCTCOUNT ( equipment_health[equipment_id] ),
            KEEPFILTERS ( equipment_health[vibration_alert] = TRUE () )
        )

    MEASURE equipment_health[アラート設備数] =
        CALCULATE (
            DISTINCTCOUNT ( equipment_health[equipment_id] ),
            KEEPFILTERS (
                FILTER (
                    ALL ( equipment_health[temperature_alert], equipment_health[vibration_alert] ),
                    equipment_health[temperature_alert] || equipment_health[vibration_alert]
                )
            )
        )

    MEASURE equipment_health[異常発生設備数] =
        CALCULATE (
            DISTINCTCOUNT ( equipment_health[equipment_id] ),
            KEEPFILTERS ( equipment_health[abnormal_count] > 0 )
        )

    MEASURE equipment_health[平均温度 (7日)] = AVERAGE ( equipment_health[rolling_7d_avg_temperature] )

    MEASURE equipment_health[最高温度] = MAX ( equipment_health[daily_max_temperature] )

    MEASURE equipment_health[平均振動 (7日)] = AVERAGE ( equipment_health[rolling_7d_avg_vibration] )

    MEASURE equipment_health[最大振動] = MAX ( equipment_health[daily_max_vibration] )

    MEASURE equipment_health[最終日 (設備)] =
        CALCULATE (
            MAX ( equipment_health[production_date] ),
            REMOVEFILTERS ( dim_line ),
            REMOVEFILTERS ( dim_equipment )
        )

    MEASURE equipment_health[監視設備数 (最終日)] =
        VAR _d = [最終日 (設備)]
        RETURN
            CALCULATE ( [監視設備数], dim_date[calendar_date] = _d )

    MEASURE equipment_health[アラート設備数 (最終日)] =
        VAR _d = [最終日 (設備)]
        RETURN
            COALESCE ( CALCULATE ( [アラート設備数], dim_date[calendar_date] = _d ), 0 )

    MEASURE equipment_health[異常発生回数 (最終日)] =
        VAR _d = [最終日 (設備)]
        RETURN
            COALESCE ( CALCULATE ( [異常発生回数], dim_date[calendar_date] = _d ), 0 )

    MEASURE equipment_health[正常稼働率 (最終日)] =
        VAR _d = [最終日 (設備)]
        RETURN
            CALCULATE ( [正常稼働率 (簡易)], dim_date[calendar_date] = _d )

    MEASURE equipment_health[状態 (最終日)] =
        VAR _d = [最終日 (設備)]
        RETURN
            CALCULATE (
                SELECTEDVALUE ( equipment_health[status_summary] ),
                dim_date[calendar_date] = _d
            )

    MEASURE equipment_health[平均温度 (7日) (最終日)] =
        VAR _d = [最終日 (設備)]
        RETURN
            CALCULATE ( [平均温度 (7日)], dim_date[calendar_date] = _d )

    MEASURE equipment_health[平均振動 (7日) (最終日)] =
        VAR _d = [最終日 (設備)]
        RETURN
            CALCULATE ( [平均振動 (7日)], dim_date[calendar_date] = _d )

    MEASURE equipment_health[異常回数 (最終日・行)] =
        VAR _d = [最終日 (設備)]
        RETURN
            CALCULATE ( [異常発生回数], dim_date[calendar_date] = _d )

    MEASURE daily_production_kpi[達成率 目標] = 1.00

    MEASURE daily_production_kpi[達成率 注意閾値] = 0.95

    MEASURE daily_production_kpi[不良率 目標] = 0.05

    MEASURE daily_production_kpi[不良率 注意閾値] = 0.04

    MEASURE daily_production_kpi[温度 注意閾値] = 60

    MEASURE daily_production_kpi[温度 警報閾値] = 65

    MEASURE daily_production_kpi[振動 注意閾値] = 3.0

    MEASURE daily_production_kpi[振動 警報閾値] = 3.5

    MEASURE daily_production_kpi[_色 良好] = "#1E8E3E"

    MEASURE daily_production_kpi[_色 注意] = "#F9A825"

    MEASURE daily_production_kpi[_色 異常] = "#D93025"

    MEASURE daily_production_kpi[達成率 色] =
        VAR _v = [達成率]
        RETURN
            SWITCH (
                TRUE (),
                ISBLANK ( _v ), BLANK (),
                _v >= [達成率 目標], [_色 良好],
                _v >= [達成率 注意閾値], [_色 注意],
                [_色 異常]
            )

    MEASURE daily_production_kpi[達成率 色 (最終日)] =
        VAR _d = [最終日]
        RETURN
            CALCULATE ( [達成率 色], dim_date[calendar_date] = _d )

    MEASURE daily_production_kpi[不良率 色] =
        VAR _v = [不良率]
        RETURN
            SWITCH (
                TRUE (),
                ISBLANK ( _v ), BLANK (),
                _v > [不良率 目標], [_色 異常],
                _v > [不良率 注意閾値], [_色 注意],
                [_色 良好]
            )

    MEASURE daily_production_kpi[不良率 色 (最終日)] =
        VAR _d = [最終日]
        RETURN
            CALCULATE ( [不良率 色], dim_date[calendar_date] = _d )

    MEASURE daily_production_kpi[温度 色] =
        VAR _v = [平均温度 (7日)]
        RETURN
            SWITCH (
                TRUE (),
                ISBLANK ( _v ), BLANK (),
                _v > [温度 警報閾値], [_色 異常],
                _v > [温度 注意閾値], [_色 注意],
                [_色 良好]
            )

    MEASURE daily_production_kpi[振動 色] =
        VAR _v = [平均振動 (7日)]
        RETURN
            SWITCH (
                TRUE (),
                ISBLANK ( _v ), BLANK (),
                _v > [振動 警報閾値], [_色 異常],
                _v > [振動 注意閾値], [_色 注意],
                [_色 良好]
            )

    MEASURE daily_production_kpi[設備状態 色] =
        VAR _measured = [計測数]
        VAR _alerts = [アラート設備数]
        VAR _abnormal = [異常発生回数]
        VAR _temp = [平均温度 (7日)]
        VAR _vib = [平均振動 (7日)]
        RETURN
            SWITCH (
                TRUE (),
                ISBLANK ( _measured ), BLANK (),
                _alerts > 0 || _abnormal > 0, [_色 異常],
                _temp > [温度 注意閾値] || _vib > [振動 注意閾値], [_色 注意],
                [_色 良好]
            )

    MEASURE daily_production_kpi[温度 色 (最終日)] =
        VAR _d = [最終日 (設備)]
        RETURN
            CALCULATE ( [温度 色], dim_date[calendar_date] = _d )

    MEASURE daily_production_kpi[振動 色 (最終日)] =
        VAR _d = [最終日 (設備)]
        RETURN
            CALCULATE ( [振動 色], dim_date[calendar_date] = _d )

    MEASURE daily_production_kpi[設備状態 色 (最終日)] =
        VAR _d = [最終日 (設備)]
        RETURN
            CALCULATE ( [設備状態 色], dim_date[calendar_date] = _d )

    VAR __last_equipment_date = [最終日 (設備)]

// 検証 1: 比率の再計算と行平均の違い
EVALUATE
ROW (
    "達成率 (合計から再計算)", [達成率],
    "達成率 (行平均・誤り)", AVERAGE ( daily_production_kpi[achievement_rate] ),
    "不良率 (合計から再計算)", [不良率],
    "不良率 (行平均・誤り)", AVERAGE ( daily_production_kpi[defect_rate] )
)

// 検証 2: ライン別の最終日 KPI
EVALUATE
SUMMARIZECOLUMNS (
    dim_line[line_name],
    "最終日", [最終日],
    "実績数", [実績数 (最終日)],
    "達成率", [達成率 (最終日)],
    "前日比", [実績数 前日比 (最終日)],
    "不良率", [不良率 (最終日)]
)
ORDER BY dim_line[line_name]

// 検証 3: 設備別の最終日の状態
EVALUATE
SUMMARIZECOLUMNS (
    dim_equipment[equipment_name],
    TREATAS ( { __last_equipment_date }, dim_date[calendar_date] ),
    "平均温度 (7日)", [平均温度 (7日)],
    "平均振動 (7日)", [平均振動 (7日)],
    "異常発生回数", [異常発生回数],
    "アラート設備数", [アラート設備数]
)
ORDER BY dim_equipment[equipment_name]
